# Copy to .env.local for local development. Set the same keys in Vercel.

# Supabase project for website leads (Project Settings -> API). Inquiries go
# through the submit_lead() function; the publishable key cannot read leads.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Optional: email each new inquiry (resend.com). Without a verified domain,
# Resend can only send to the account's own address.
RESEND_API_KEY=
LEAD_NOTIFY_TO=
LEAD_NOTIFY_FROM=

# Optional: booking page shown after an inquiry and on the contact page
# (Cal.com, Calendly or a Google Calendar appointment schedule link).
NEXT_PUBLIC_BOOKING_URL=
