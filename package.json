    "test:source-examples": "node tests/source-examples/integration.mjs",
    "test:leads": "tsc lib/leads/validate.ts --outDir .test-leads --module commonjs --target es2020 --skipLibCheck && node --test tests/leads/*.test.cjs",
    "test:reporting": "tsc -p examples/tsconfig.json && node tests/source-examples/reporting.mjs"
